# ============================================================
# Competitor Monitor — Required Environment Variables
# Copy this file to .env.local (for Next.js) and fill in values.
# Python scraper reads DATABASE_URL directly.
# ============================================================

# ---- Database (Vercel Postgres / Neon) ----
# Used by Next.js / Prisma (apps/web)
competitor_monitor_POSTGRES_URL="postgresql://user:pass@host/db?sslmode=require"
competitor_monitor_POSTGRES_URL_NON_POOLING="postgresql://user:pass@host/db?sslmode=require"

# Used by Python scraper (packages/scraper/src/db.py)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ---- Vercel Blob Storage ----
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ---- Slack Notifications ----
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# ---- Next.js App URL (used in Slack notification links) ----
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# ---- NextAuth (Google OAuth) ----
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="your-nextauth-secret"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ---- Optional: disable press release Slack notifications (CI use) ----
# PRESS_NOTIFICATIONS_DISABLED="true"
